+/* ============================================================
+   THEME TOGGLE
+   ============================================================ */
+.theme-toggle {
+    display: grid;
+    place-items: center;
+    width: 38px;
+    height: 38px;
+    border: 1px solid var(--line-2);
+    border-radius: 50%;
+    color: var(--ink-2);
+    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
+}
+.theme-toggle:hover { color: var(--accent-text); border-color: var(--accent); }
+[data-theme="midnight"] .theme-toggle .icon-moon { display: none; }
+[data-theme="ivory"] .theme-toggle .icon-sun { display: none; }
+
+/* ============================================================
+   HERO — portrait column & socials
+   ============================================================ */
+.hero-inner {
+    display: grid;
+    grid-template-columns: 1fr auto;
+    gap: clamp(2rem, 5vw, 4.5rem);
+    align-items: center;
+}
+.hero-portrait { position: relative; }
+.hero-portrait img {
+    width: clamp(190px, 24vw, 300px);
+    border-radius: 12px;
+    border: 1px solid var(--line-2);
+    box-shadow: 0 24px 60px -24px var(--shadow);
+    display: block;
+    transition: transform var(--t-med) var(--ease);
+}
+.hero-portrait:hover img { transform: translateY(-4px); }
+.hero-portrait::after {
+    content: '';
+    position: absolute;
+    inset: 16px -16px -16px 16px;
+    border: 1px solid var(--accent);
+    border-radius: 12px;
+    z-index: -1;
+    opacity: 0.55;
+    transition: inset var(--t-med) var(--ease), opacity var(--t-med) var(--ease);
+}
+.hero-portrait:hover::after { inset: 21px -21px -21px 21px; opacity: 0.85; }
+.hero-socials {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 0.5rem 1.5rem;
+    margin-top: 2.4rem;
+}
+.hero-socials a {
+    font-family: var(--font-mono);
+    font-size: 0.6875rem;
+    font-weight: 500;
+    letter-spacing: 0.12em;
+    text-transform: uppercase;
+    color: var(--ink-2);
+    transition: color var(--t-fast);
+}
+.hero-socials a:hover { color: var(--accent-text); }
+
+/* ============================================================
+   04 · SKILLS
+   ============================================================ */
+.skills-grid {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 1.25rem;
+}
+.skill-card {
+    background: var(--paper);
+    border: 1px solid var(--line);
+    border-radius: 10px;
+    padding: 1.75rem 1.75rem 1.9rem;
